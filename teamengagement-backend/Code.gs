/**
 * The Report-Out: GitHub Pages + Google Sheets storage.
 *
 * Paste this file into a spreadsheet-bound Google Apps Script project.
 * Run setupReportOut once as the spreadsheet owner, then deploy as:
 *   Execute as: Me
 *   Who has access: Anyone (including anonymous visitors)
 *
 * The spreadsheet remains private; visitors never receive Sheets access.
 */

const REPORT_OUT_TABS = {
  rounds: ['id', 'question', 'opened_at', 'closed_at'],
  answers: ['round_id', 'answer', 'device_id', 'submitted_at', 'normalized'],
  receipts: ['request_id', 'created_at', 'ok', 'error']
};

function setupReportOut() {
  const spreadsheet = SpreadsheetApp.getActiveSpreadsheet();
  if (!spreadsheet) throw new Error('Open this script from Extensions > Apps Script in a Google Sheet.');
  const props = PropertiesService.getScriptProperties();
  if (!props.getProperty('REPORT_OUT_SHEET_ID')) {
    props.setProperty('REPORT_OUT_SHEET_ID', spreadsheet.getId());
  }
  if (!props.getProperty('REPORT_OUT_HOST_KEY')) {
    props.setProperty('REPORT_OUT_HOST_KEY', Utilities.getUuid().replace(/-/g, '') + Utilities.getUuid().replace(/-/g, ''));
  }
  if (!props.getProperty('REPORT_OUT_TEAM_KEY')) {
    props.setProperty('REPORT_OUT_TEAM_KEY', Utilities.getUuid().replace(/-/g, '') + Utilities.getUuid().replace(/-/g, ''));
  }
  Object.keys(REPORT_OUT_TABS).forEach(function(name) {
    let sheet = spreadsheet.getSheetByName(name);
    if (!sheet) sheet = spreadsheet.insertSheet(name);
    if (sheet.getLastRow() === 0) {
      sheet.appendRow(REPORT_OUT_TABS[name]);
      sheet.setFrozenRows(1);
    }
  });
  SpreadsheetApp.flush();
  Logger.log('Keep this HOST KEY private: ' + props.getProperty('REPORT_OUT_HOST_KEY'));
  Logger.log('The TEAM KEY is automatically added to the link from Host Controls: ' + props.getProperty('REPORT_OUT_TEAM_KEY'));
  return 'Ready! Find your HOST KEY in the execution log. Never share the Google Sheet.';
}

function doGet(event) {
  const p = event && event.parameter ? event.parameter : {};
  const callback = p.callback || '';
  // Only a callback name generated by our own site can be executed.
  if (!/^reportOutCb_[a-zA-Z0-9_]{1,80}$/.test(callback)) {
    return ContentService.createTextOutput('/* Invalid callback */')
      .setMimeType(ContentService.MimeType.JAVASCRIPT);
  }
  try {
    let result;
    if (p.action === 'state') {
      verifyTeam_(p.key);
      result = state_(p.device || '');
    } else if (p.action === 'admin') {
      verifyHost_(p.key);
      result = admin_();
    } else if (p.action === 'export') {
      verifyHost_(p.key);
      result = { csv: exportCsv_(p.round || '') };
    } else if (p.action === 'receipt') {
      verifyKey_(p.key);
      result = receipt_(p.requestId || '');
    } else {
      throw new Error('Unknown request.');
    }
    return javascript_(callback, { ok: true, data: result });
  } catch (err) {
    return javascript_(callback, { ok: false, error: String(err.message || err) });
  }
}

function doPost(event) {
  const p = event && event.parameter ? event.parameter : {};
  const requestId = String(p.requestId || '');
  const lock = LockService.getScriptLock();
  try {
    lock.waitLock(15000);
    let message = '';
    let allowed = false;
    try {
      verifyKey_(p.key);
      allowed = true;
      if (p.action === 'answer') {
        verifyTeam_(p.key);
        addAnswer_(p);
      } else if (p.action === 'open') {
        verifyHost_(p.key);
        openRound_(p.question);
      } else if (p.action === 'close') {
        verifyHost_(p.key);
        closeRound_(p.roundId);
      } else {
        throw new Error('Unknown request.');
      }
    } catch (err) {
      message = String(err.message || err);
    }
    if (allowed && /^[a-zA-Z0-9-]{10,80}$/.test(requestId)) {
      tab_('receipts').appendRow([requestId, new Date().toISOString(), !message, message]);
    }
    SpreadsheetApp.flush();
  } finally {
    try { lock.releaseLock(); } catch (_) {}
  }
  return ContentService.createTextOutput('Request processed')
    .setMimeType(ContentService.MimeType.TEXT);
}

function javascript_(callback, value) {
  return ContentService.createTextOutput(callback + '(' + JSON.stringify(value) + ');')
    .setMimeType(ContentService.MimeType.JAVASCRIPT);
}

function properties_() {
  return PropertiesService.getScriptProperties();
}

function verifyHost_(key) {
  if (!key || key !== properties_().getProperty('REPORT_OUT_HOST_KEY')) {
    throw new Error('Invalid host key.');
  }
}

function verifyTeam_(key) {
  if (!key || key !== properties_().getProperty('REPORT_OUT_TEAM_KEY')) {
    throw new Error('Invalid team link.');
  }
}

function verifyKey_(key) {
  const props = properties_();
  if (!key || (key !== props.getProperty('REPORT_OUT_HOST_KEY') &&
               key !== props.getProperty('REPORT_OUT_TEAM_KEY'))) {
    throw new Error('Invalid team link or host key.');
  }
}

function tab_(name) {
  const id = properties_().getProperty('REPORT_OUT_SHEET_ID');
  if (!id) throw new Error('Run setupReportOut once before deploying.');
  const book = SpreadsheetApp.openById(id);
  const sheet = book.getSheetByName(name);
  if (!sheet) throw new Error('Missing sheet ' + name + '. Run setupReportOut again.');
  return sheet;
}

function rows_(name) {
  const sheet = tab_(name);
  if (sheet.getLastRow() < 2) return [];
  return sheet.getRange(2, 1, sheet.getLastRow() - 1, REPORT_OUT_TABS[name].length).getValues();
}

function rounds_() {
  return rows_('rounds').map(function(row) {
    return { id: String(row[0]), question: String(row[1]),
      opened_at: String(row[2]), closed_at: row[3] ? String(row[3]) : null };
  });
}

function responseRows_() {
  return rows_('answers').map(function(row) {
    return { roundId: String(row[0]), answer: String(row[1]),
      deviceId: String(row[2]), submittedAt: String(row[3]), normalized: String(row[4]) };
  });
}

function current_(list) {
  return list.length ? list[list.length - 1] : null;
}

function state_(deviceId) {
  const round = current_(rounds_());
  if (!round) return { round: null, answers: [], total: 0, responded: false };
  const entries = responseRows_().filter(function(item) { return item.roundId === round.id; });
  const groups = {};
  entries.forEach(function(item) {
    const key = item.normalized || item.answer.toLowerCase();
    if (!groups[key]) groups[key] = { answer: item.answer, count: 0 };
    groups[key].count += 1;
  });
  const answers = Object.keys(groups).map(function(key) { return groups[key]; })
    .sort(function(a, b) { return b.count - a.count || a.answer.localeCompare(b.answer); });
  return { round: round, answers: answers, total: entries.length,
    responded: !!deviceId && entries.some(function(item) { return item.deviceId === deviceId; }) };
}

function admin_() {
  const entries = responseRows_();
  const list = rounds_().reverse().map(function(r) {
    return { id: r.id, question: r.question, opened_at: r.opened_at,
      closed_at: r.closed_at, count: entries.filter(function(e) { return e.roundId === r.id; }).length };
  });
  return { teamKey: properties_().getProperty('REPORT_OUT_TEAM_KEY'), rounds: list };
}

function receipt_(id) {
  if (!/^[a-zA-Z0-9-]{10,80}$/.test(id)) throw new Error('Invalid request ID.');
  const receipts = rows_('receipts');
  for (let i = receipts.length - 1; i >= 0; i--) {
    if (String(receipts[i][0]) === id) {
      return { done: true, ok: receipts[i][2] === true || String(receipts[i][2]) === 'true',
        error: String(receipts[i][3] || '') };
    }
  }
  return { done: false };
}

function addAnswer_(p) {
  const round = current_(rounds_());
  if (!round || round.closed_at || String(p.roundId || '') !== round.id) {
    throw new Error('This question is no longer open. Refresh the page.');
  }
  const deviceId = String(p.deviceId || '');
  const answer = String(p.answer || '').trim().replace(/\s+/g, ' ');
  if (!/^[a-zA-Z0-9-]{30,80}$/.test(deviceId)) throw new Error('Invalid device identifier.');
  if (!answer || answer.length > 48) throw new Error('Please enter a word or phrase up to 48 characters.');
  if (/[\x00-\x1F\x7F]/.test(answer)) throw new Error('Please remove control characters.');
  const already = responseRows_().some(function(row) {
    return row.roundId === round.id && row.deviceId === deviceId;
  });
  if (already) throw new Error('You have already answered this question.');
  tab_('answers').appendRow([round.id, answer, deviceId, new Date().toISOString(), answer.toLowerCase()]);
}

function openRound_(questionInput) {
  const question = String(questionInput || '').trim().replace(/\s+/g, ' ');
  if (!question || question.length > 160) throw new Error('Enter a question up to 160 characters.');
  const sheet = tab_('rounds');
  const list = rounds_();
  const last = current_(list);
  if (last && !last.closed_at) sheet.getRange(list.length + 1, 4).setValue(new Date().toISOString());
  sheet.appendRow([Utilities.getUuid(), question, new Date().toISOString(), '']);
}

function closeRound_(roundId) {
  const list = rounds_();
  const round = current_(list);
  if (!round || round.id !== String(roundId || '') || round.closed_at) {
    throw new Error('That question is not open.');
  }
  tab_('rounds').getRange(list.length + 1, 4).setValue(new Date().toISOString());
}

function csvCell_(value) {
  let text = String(value == null ? '' : value);
  // Prevent spreadsheet formula execution when CSV is opened in Excel/Sheets.
  if (/^[\s]*[=+\-@]/.test(text)) text = "'" + text;
  return '"' + text.replace(/"/g, '""') + '"';
}

function exportCsv_(selectedId) {
  const list = rounds_();
  if (selectedId && !list.some(function(r) { return r.id === selectedId; })) {
    throw new Error('Question not found.');
  }
  const byId = {};
  list.forEach(function(r) { byId[r.id] = r; });
  const out = [['Question ID', 'Question', 'Opened At', 'Closed At', 'Submitted At', 'Answer']];
  responseRows_().forEach(function(a) {
    if (selectedId && selectedId !== a.roundId) return;
    const r = byId[a.roundId];
    if (r) out.push([r.id, r.question, r.opened_at, r.closed_at || '',
      a.submittedAt, a.answer]);
  });
  return '\uFEFF' + out.map(function(r) { return r.map(csvCell_).join(','); }).join('\r\n') + '\r\n';
}
